#!/usr/bin/env bash
# Stand in for clang as the linker of a .NET Native AOT build for
# linux-musl: link with Zig's bundled clang, lld and musl, so that no musl
# has to be installed. Used by build.sh only.
args=()
for a in "$@"; do
    case "$a" in
        --target=*|-fuse-ld=*|-gz=*) ;;   # zig cc sets these itself
        -Wl,--defsym,*) ;;                # not passed on by zig cc; unused here
        *) args+=("$a") ;;
    esac
done
exec zig cc -target x86_64-linux-musl "${args[@]}"
