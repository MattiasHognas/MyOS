
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MyOS: Host tests",
      "type": "shell",
      "command": "zig build test-host",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MyOS: Kernel tests (QEMU)",
      "type": "shell",
      "command": "zig build test-qemu",
      "group": "test",
      "problemMatcher": []
    },
    {
      // preLaunchTask of the "MyOS: Debug kernel ... (QEMU)" launch configurations.
      // --no-kvm: under TCG, breakpoints set from the editor work before the
      // kernel is loaded; under KVM only hardware breakpoints do.
      "label": "MyOS: QEMU (wait for debugger)",
      "type": "shell",
      "command": "MYOS_KASLR=no scripts/build.sh && scripts/run-qemu.sh --gdb --no-kvm -- -pidfile zig-out/qemu-debug.pid",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^__no_problems_reported__$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^__never__$",
          "endsPattern": "QEMU is waiting for GDB"
        }
      }
    },
    {
      // postDebugTask: QEMU runs with -no-shutdown, so it only pauses when the
      // debugger kills the session and has to be stopped separately.
      "label": "MyOS: Stop QEMU (debug)",
      "type": "shell",
      "command": "pkill -F zig-out/qemu-debug.pid qemu-system; true",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "MyOS: All tests",
      "type": "shell",
      "command": "zig build test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
