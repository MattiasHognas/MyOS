# The tool versions MyOS is built and tested with, and the SHA-256 of each
# release archive. This is the one place they are written down:
#
# - scripts/install-*.sh install exactly these (CI uses them; they work on
#   a development machine too);
# - scripts/check-tools.sh compares the tools on PATH with them. It fails
#   in CI and warns on a development machine (docs/development.md).
#
# To move to a new version: change the version and checksum here.
# Plain NAME=value lines: the scripts read this file with `source`.

ZIG_VERSION=0.17.1
